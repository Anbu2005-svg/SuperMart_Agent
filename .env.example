# ── Telegram Bot ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── LLM Provider (Ollama Cloud OpenAI-Compatible API) ────────────────
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=nemotron-3-super

# Dual API key pool for rate-limit failover & load balancing
LLM_API_KEY_1=your_ollama_api_key_1_here
LLM_API_KEY_2=your_ollama_api_key_2_here

# ── PostgreSQL Cloud Database (Render / Supabase / Neon / Prisma) ────
DATABASE_URL=postgresql://postgres:password@host:5432/supermarket_db?sslmode=require
DB_PATH=supermarket.db

# ── Server Port & Authentication ─────────────────────────────────────
PORT=8080
REQUIRE_AUTH=true

# ── Voice Note Audio Transcription (100% Free via Groq Whisper) ─────
# Sign up at https://console.groq.com (no credit card required, 2000 free requests/day)
GROQ_API_KEY=your_groq_api_key_here
# Optional manual overrides:
# VOICE_TRANSCRIBE_API_KEY=
# VOICE_TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# VOICE_TRANSCRIBE_MODEL=whisper-large-v3-turbo


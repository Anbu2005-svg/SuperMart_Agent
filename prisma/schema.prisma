// Prisma Schema for PostgreSQL Deployment
// Project: SuperMart AI Ops Agent

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-py"
}

model Product {
  sku_id              String       @id
  name                String
  category            String
  unit                String
  base_unit           String       @default("piece")
  conversion_factor   Float        @default(1.0)
  price_per_base_unit Float?
  is_loose            Boolean      @default(false)
  cost_price          Float
  mrp                 Float
  gst_slab            Float        @default(0)
  hsn_code            String?
  quantity            Float        @default(0)
  reorder_level       Float        @default(10)
  is_active           Boolean?     @default(true)
  created_at          DateTime?    @default(now())
  updated_at          DateTime?    @default(now())
  bill_items          BillItem[]
  stock_batches       StockBatch[]

  @@index([is_active], name: "idx_products_active")
  @@map("products")
}

model StockBatch {
  batch_id      Int       @id @default(autoincrement())
  sku_id        String
  batch_code    String
  qty_received  Float
  qty_remaining Float
  cost_price    Float
  expiry_date   DateTime? @db.Date
  received_at   DateTime? @default(now())
  product       Product   @relation(fields: [sku_id], references: [sku_id], onDelete: Cascade)

  @@unique([sku_id, batch_code])
  @@index([sku_id], name: "idx_batches_sku")
  @@index([expiry_date], name: "idx_batches_expiry")
  @@map("stock_batches")
}

model Customer {
  customer_id        Int                 @id @default(autoincrement())
  name               String              @unique
  khata_balance      Float               @default(0)
  credit_limit       Float?              @default(0)
  phone              String?
  address            String?
  created_at         DateTime?           @default(now())
  updated_at         DateTime?           @default(now())
  bills              Bill[]
  khata_transactions KhataTransaction[]

  @@map("customers")
}

model Bill {
  bill_id            String              @id
  status             String              @default("draft")
  customer_id        Int?
  payment_mode       String?
  payment_ref        String?
  subtotal           Float               @default(0)
  cgst               Float               @default(0)
  sgst               Float               @default(0)
  total              Float               @default(0)
  invoice_number     Int?
  place_of_supply    String?
  created_at         DateTime            @default(now())
  finalized_at       DateTime?
  customer           Customer?           @relation(fields: [customer_id], references: [customer_id])
  bill_items         BillItem[]
  khata_transactions KhataTransaction[]

  @@index([finalized_at], name: "idx_bills_finalized_at")
  @@index([status], name: "idx_bills_status")
  @@map("bills")
}

model BillItem {
  id         Int     @id @default(autoincrement())
  bill_id    String
  sku_id     String
  qty        Float
  unit_price Float
  gst_slab   Float   @default(0)
  line_total Float
  bill       Bill    @relation(fields: [bill_id], references: [bill_id])
  product    Product @relation(fields: [sku_id], references: [sku_id])

  @@index([sku_id], name: "idx_bill_items_sku")
  @@index([bill_id], name: "idx_bill_items_bill")
  @@map("bill_items")
}

model KhataTransaction {
  id          Int      @id @default(autoincrement())
  customer_id Int
  type        String
  amount      Float
  bill_id     String?
  created_at  DateTime @default(now())
  customer    Customer @relation(fields: [customer_id], references: [customer_id])
  bill        Bill?    @relation(fields: [bill_id], references: [bill_id])

  @@index([customer_id], name: "idx_khata_customer")
  @@map("khata_transactions")
}

model Preference {
  owner_id String
  key      String
  value    String

  @@id([owner_id, key])
  @@map("preferences")
}

model IdempotencyLog {
  update_id    String    @id
  reply_text   String?
  file_paths   String?
  processed_at DateTime? @default(now())

  @@map("idempotency_log")
}

model UserRateLimit {
  telegram_id  String @id
  tokens       Float
  last_updated Float

  @@map("user_rate_limits")
}

model Shop {
  shop_id         Int           @id @default(autoincrement())
  shop_name       String        @unique
  password_hash   String
  shop_address    String?
  shop_gstin      String?
  place_of_supply String?
  created_at      DateTime      @default(now())
  user_sessions   UserSession[]

  @@map("shops")
}

model UserSession {
  telegram_id      String   @id
  shop_id          Int
  authenticated_at DateTime @default(now())
  shop             Shop     @relation(fields: [shop_id], references: [shop_id])

  @@map("user_sessions")
}

model AuthenticatedUser {
  telegram_id      String   @id
  phone_number     String?
  authenticated_at DateTime @default(now())

  @@map("authenticated_users")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  event_type  String
  entity_type String?
  entity_id   String?
  details     String?
  old_value   Float?
  new_value   Float?
  created_at  DateTime @default(now())

  @@index([entity_id], name: "idx_audit_entity")
  @@index([event_type], name: "idx_audit_event")
  @@map("audit_log")
}
